# =============================================================================
# New Starters MeetUp - Lambda environment variables
# =============================================================================
# 
# SECURITY WARNING: Never commit actual credentials to version control!
# Set these on the Lambda functions. Everything else (Slack, Azure AD, Google,
# table names) lives in the CONFIG_SECRET JSON; see docs/setup.md.
#
# For production, store all secrets in AWS Secrets Manager instead.
# =============================================================================

CONFIG_SECRET=arn:aws:secretsmanager:eu-west-1:123456789012:secret:intro-config

# Lambda Configuration
WORKER_FUNCTION_NAME=intro-worker-lambda

# Worker Lambda only: Python log level (default INFO)
LOG_LEVEL=INFO
